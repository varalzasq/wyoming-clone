generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  firstName String
  lastName  String
  phone     String
  role      String @default("USER")

  // New Fields
  address     String?
  city        String?
  state       String?
  zip         String?
  partnerCode String?

  llcOrders    LlcRegistration[]
  balances     VirtualBalance[]
  transactions Transaction[]
  createdAt    DateTime          @default(now())
}

model LlcRegistration {
  id String @id @default(uuid())

  // Link to User
  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyName String
  designator  String
  state       String
  industry    String

  registeredAgent Boolean @default(false)
  mailForwarding  Boolean @default(false)
  einApplication  Boolean @default(false)

  // Crypto Asset Protection Features
  cryptoProtectionActive Boolean @default(false)
  walletShippingAddress  String?
  roiTrackingStatus      String  @default("PENDING_ACTIVATION")
  legalDocsSent          Boolean @default(false)

  status String @default("PENDING_PAYMENT")

  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model WalletAsset {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  network   String
  iconColor String
  iconUrl   String
  price     Float    @default(0.0)
  change    Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances VirtualBalance[]
}

model VirtualBalance {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  assetId   String
  asset     WalletAsset @relation(fields: [assetId], references: [id])
  amount    Float       @default(0.0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, assetId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String // DEPOSIT, WITHDRAWAL, SWAP
  assetSymbol String
  amount      Float
  status      String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  txHash      String?
  createdAt   DateTime @default(now())
}
